{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Geko",
  "description": "Text-to-speech API for Kazakh — and beyond. A thin, familiar SDK and a simple HTTP API.",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ADE80",
    "dark": "#15803D"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": ["index", "quickstart", "authentication"]
      },
      {
        "group": "SDK",
        "icon": "code",
        "pages": ["sdk/typescript", "sdk/cli", "sdk/errors"]
      },
      {
        "group": "API reference",
        "icon": "server",
        "pages": ["api/reference"]
      },
      {
        "group": "Guides",
        "icon": "book-open",
        "pages": [
          "guides/playing-audio",
          "guides/frameworks",
          "guides/openai",
          "guides/latency",
          "guides/normalization"
        ]
      },
      {
        "group": "Reference",
        "icon": "list",
        "pages": ["voices", "billing", "limits", "faq", "changelog", "roadmap"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/gekoai"
      },
      {
        "label": "npm",
        "href": "https://www.npmjs.com/package/@gekoai/sdk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://app.geko.sh"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/gekoai"
    }
  }
}
