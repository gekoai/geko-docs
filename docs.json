{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "geko",
  "description": "Text-to-speech API for Kazakh — and beyond. A thin, familiar SDK and a simple HTTP API.",
  "colors": {
    "primary": "#789B33",
    "light": "#9DBF57",
    "dark": "#5F7D28"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Geist Mono",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "background": {
    "color": {
      "light": "#FAFAF7",
      "dark": "#0A0B07"
    }
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://geko.sh"
  },
  "favicon": "/images/geko-icon.png",
  "navigation": {
    "groups": [
      {
        "group": "get started",
        "icon": "rocket",
        "pages": ["index", "quickstart", "authentication"]
      },
      {
        "group": "sdk",
        "icon": "code",
        "pages": ["sdk/typescript", "sdk/cli", "sdk/errors"]
      },
      {
        "group": "api reference",
        "icon": "server",
        "pages": ["api/reference"]
      },
      {
        "group": "guides",
        "icon": "book-open",
        "pages": [
          "guides/playing-audio",
          "guides/frameworks",
          "guides/openai",
          "guides/latency",
          "guides/normalization"
        ]
      },
      {
        "group": "reference",
        "icon": "list",
        "pages": ["voices", "billing", "limits", "faq", "changelog", "roadmap"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "github",
        "href": "https://github.com/gekoai"
      },
      {
        "label": "npm",
        "href": "https://www.npmjs.com/package/@gekoai/sdk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "get an api key",
      "href": "https://app.geko.sh"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/gekoai"
    }
  }
}
