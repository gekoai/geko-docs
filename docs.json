{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "geko",
  "description": "Speech API for Kazakh \u2014 and beyond. Text-to-speech and speech-to-text on one API key, with a thin, familiar SDK and a simple HTTP API.",
  "colors": {
    "primary": "#789B33",
    "light": "#9DBF57",
    "dark": "#5F7D28"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "Geist Mono",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "background": {
    "color": {
      "light": "#FAFAF7",
      "dark": "#0A0B07"
    }
  },
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://geko.sh"
  },
  "favicon": "/images/geko-icon.png",
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "redirects": [
    {
      "source": "/voices",
      "destination": "/tts/voices",
      "permanent": true
    },
    {
      "source": "/guides/playing-audio",
      "destination": "/tts/playing-audio",
      "permanent": true
    },
    {
      "source": "/guides/streaming",
      "destination": "/tts/streaming",
      "permanent": true
    },
    {
      "source": "/guides/latency",
      "destination": "/tts/latency",
      "permanent": true
    },
    {
      "source": "/guides/normalization",
      "destination": "/tts/normalization",
      "permanent": true
    },
    {
      "source": "/guides/openai",
      "destination": "/tts/openai",
      "permanent": true
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "documentation",
        "groups": [
          {
            "group": "get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "text-to-speech",
            "icon": "waveform-lines",
            "pages": [
              "tts/index",
              "tts/voices",
              "tts/playing-audio",
              "tts/streaming",
              "tts/latency",
              "tts/normalization",
              "tts/openai"
            ]
          },
          {
            "group": "speech-to-text",
            "icon": "microphone",
            "pages": [
              "stt/index",
              "stt/timestamps",
              "stt/accuracy",
              "stt/openai"
            ]
          },
          {
            "group": "guides",
            "icon": "book-open",
            "pages": [
              "guides/frameworks",
              "guides/voice-agents"
            ]
          },
          {
            "group": "sdk",
            "icon": "code",
            "pages": [
              "sdk/typescript",
              "sdk/cli",
              "sdk/errors"
            ]
          },
          {
            "group": "reference",
            "icon": "list",
            "pages": [
              "billing",
              "limits",
              "faq",
              "changelog",
              "roadmap"
            ]
          }
        ]
      },
      {
        "tab": "api reference",
        "groups": [
          {
            "group": "api reference",
            "openapi": "openapi.json",
            "pages": [
              "api/reference",
              "POST /v1/tts",
              "POST /v1/tts/stream",
              "POST /v1/audio/speech",
              "POST /v1/transcribe",
              "POST /v1/audio/transcriptions",
              "GET /v1/models",
              "GET /v1/voices",
              "GET /health"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "github",
        "href": "https://github.com/gekoai"
      },
      {
        "label": "npm",
        "href": "https://www.npmjs.com/package/@gekoai/sdk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "get an api key",
      "href": "https://app.geko.sh"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/gekoai"
    }
  }
}
